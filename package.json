{
  "name": "@tssuite/gg-bridge-dart-typescript",
  "version": "1.0.2",
  "description": "Bridge exposing a Dart package as a JavaScript and WebAssembly module with hand-typed TypeScript declarations.",
  "keywords": [
    "dart",
    "wasm",
    "webassembly",
    "bridge",
    "interop",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "node": "./dist/index.node.js",
      "default": "./dist/index.js"
    },
    "./wasm": "./dist/bridge-wasm.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-version": "dart run scripts/sync_version.dart",
    "build:dart": "dart run build.dart",
    "build:dart:debug": "dart run build.dart --debug",
    "build:ts": "tsc -p tsconfig.json && vite build && cp typescript/generated/bridge-wasm.wasm dist/bridge-wasm.wasm",
    "build": "pnpm run clean && pnpm run sync-version && pnpm run build:dart && pnpm run build:ts",
    "clean": "rm -rf dist typescript/generated && mkdir -p typescript/generated",
    "test:dart": "dart test",
    "test:vitest": "vitest run --coverage",
    "test:node": "vitest run --project=node",
    "test:browser": "vitest run --project=browser",
    "test:coverage": "vitest run --coverage",
    "test:example": "playwright test --config example/browser/playwright.config.ts",
    "test": "pnpm run test:dart && pnpm run test:vitest && pnpm run test:browser && pnpm run test:node && pnpm run test:example && pnpm run lint",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example:browser": "vite --config example/browser/vite.config.mts",
    "example:node": "node example/node-cli/index.mjs",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.11.0",
    "jsdoc": "^4.0.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tssuite/gg-bridge-dart-typescript.git"
  },
  "homepage": "https://github.com/tssuite/gg-bridge-dart-typescript#readme",
  "bugs": {
    "url": "https://github.com/tssuite/gg-bridge-dart-typescript/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Dr. Gabriel Gatzsche",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
